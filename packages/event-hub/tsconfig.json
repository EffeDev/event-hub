{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "strict": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": "./src",
    "outDir": "./dist/esm",
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.spec.ts"]
}
